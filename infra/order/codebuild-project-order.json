{
  "name": "devops-g3-order-build",
  "description": "Build, tag, and push the order service image; emit imagedefinitions.json",
  "source": {
    "type": "CODEPIPELINE",
    "buildspec": "buildspecs/order.yml"
  },
  "artifacts": {
    "type": "CODEPIPELINE"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/standard:7.0",
    "computeType": "BUILD_GENERAL1_SMALL",
    "privilegedMode": true
  },
  "serviceRole": "arn:aws:iam::240462142849:role/devops-g3-codebuild-role",
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED"
    }
  },
  "tags": [
    { "key": "Project", "value": "devops-Ecommerce" },
    { "key": "Group", "value": "group-3" },
    { "key": "Owner", "value": "order-owner" },
    { "key": "Environment", "value": "lab" }
  ]
}
