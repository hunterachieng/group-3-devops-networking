{
    "pipeline": {
      "name": "devops-g3-payment-pipeline",
      "roleArn": "arn:aws:iam::240462142849:role/devops-g3-codepipeline-role",
      "artifactStore": {
        "type": "S3",
        "location": "devops-g3-codepipeline-artifacts-240462142849-us-west-1"
      },
      "stages": [
        {
          "name": "Source",
          "actions": [
            {
              "name": "Source",
              "actionTypeId": {
                "category": "Source",
                "owner": "AWS",
                "provider": "CodeStarSourceConnection",
                "version": "1"
              },
              "outputArtifacts": [{ "name": "SourceOutput" }],
              "configuration": {
                "ConnectionArn": "arn:aws:codeconnections:us-west-1:240462142849:connection/4a0019ec-a1d5-4853-9cbd-194e2437a95f",
                "FullRepositoryId": "hunterachieng/group-3-devops-networking",
                "BranchName": "main",
                "OutputArtifactFormat": "CODE_ZIP",
                "DetectChanges": "true"
              }
            }
          ]
        },
        {
          "name": "Build",
          "actions": [
            {
              "name": "Build",
              "actionTypeId": {
                "category": "Build",
                "owner": "AWS",
                "provider": "CodeBuild",
                "version": "1"
              },
              "inputArtifacts": [{ "name": "SourceOutput" }],
              "outputArtifacts": [{ "name": "BuildOutput" }],
              "configuration": {
                "ProjectName": "devops-g3-payment-build"
              }
            }
          ]
        }
      ],
      "pipelineType": "V2",
      "triggers": [
        {
          "providerType": "CodeStarSourceConnection",
          "gitConfiguration": {
            "sourceActionName": "Source",
            "push": [
              {
                "branches": { "includes": ["main"] },
                "filePaths": { "includes": ["payment/**"] }
              }
            ]
          }
        }
      ]
    },
    "tags": [
      { "key": "Project", "value": "devops-Ecommerce" },
      { "key": "Group", "value": "group-3" },
      { "key": "Owner", "value": "payment-owner" },
      { "key": "Environment", "value": "lab" }
    ]
  }